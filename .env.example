# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Generate independent 32+ byte secrets, for example:
# openssl rand -hex 32
OTP_HASH_SECRET=replace-with-a-unique-secret
OTP_SIGNING_SECRET=replace-with-a-different-unique-secret

# Resend Email Service
RESEND_API_KEY=re_...

# Email Settings
EMAIL_FROM="HYBE Fan-Permit <onboarding@resend.dev>"

ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
NODE_ENV=development

# OTP Rate Limiting
OTP_RATE_LIMIT_MAX_REQUESTS=3
OTP_RATE_LIMIT_TIME_WINDOW=300000
OTP_RATE_LIMIT_COOLDOWN=60000


VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=10
VERIFICATION_RATE_LIMIT_TIME_WINDOW=900000
VERIFICATION_LOCKOUT_DURATION=1800000


DB_ENCRYPTION_KEY=replace-with-an-independent-random-secret


FORCE_HTTPS=true
